            <CheckCircle class="w-6 h-6" />
            <span class="text-xl font-semibold">Mastered Topics</span>
          {/if}
        </div>
      </div>
    </div>

    <div>
      {#if isLoading}
        <!-- Skeleton loader while loading -->
        {#each Array.from({ length: 3 }, (_, i) => i) as i (i)}
