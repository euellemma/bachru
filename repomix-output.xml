	.ft05{font-size:12px;font-family:Times New Roman,BoldItalic;color:#000000;}
	.ft06{font-size:12px;font-family:Arial,BoldItalic;color:#000000;}
	.ft07{font-size:12px;font-family:Times New Roman;color:#000000;}
