  let difficultyLabel = $derived(
    topicData?.difficulty <= 5
      ? "Easy"
      : topicData?.difficulty <= 8
        ? "Medium"
        : "Challenging",
  );

  const nextFunfact = () => {
    funfactIndex = (funfactIndex + 1) % topicData?.funfacts.length;
  };
  const prevTopic = () => {
    push(`/topic/${params.courseId}/${topicData?.prevTopic?.filename}`);
